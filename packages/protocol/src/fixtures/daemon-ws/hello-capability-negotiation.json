              "terminal-size-ownership": true,
              "rewind": true,
              "agentTimelinePromptIndex": true,
              "checkoutRefresh": true,
              "workspaceMultiplicity": true,
              "projectRemove": true,
              "projectAdd": true,
              "projectList": true,
              "worktreeRestore": true,
              "workspaceRecovery": true,
              "piUiBridge": true,
              "trustedDevices": true
            }
