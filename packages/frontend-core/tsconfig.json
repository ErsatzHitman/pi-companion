{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // No ambient globals: prevents auto-inclusion of hoisted @types/*
    // packages (e.g. @types/react, @types/jsdom) from other workspaces,
    // which would otherwise leak React/DOM ambient types into this
    // platform-neutral package even without an explicit import.
    "types": [],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
