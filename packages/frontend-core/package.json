{
  "name": "@picompanion/frontend-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build --workspace=@picompanion/protocol && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "test": "vitest run"
  },
  "dependencies": {
    "@picompanion/client": "0.3.0-beta.2",
    "@picompanion/protocol": "0.3.0-beta.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
