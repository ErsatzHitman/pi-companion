{
  "scenario": "new-helper-old-client",
  "description": "A piUiPayloadV2 Pi UI helper emits a canonical typed payload with no legacy top-level fields; the daemon projects it back down to the v1 top-level shape for a client that has not negotiated piUiPayloadV2, so old clients keep working during the compatibility window even when helpers upgrade first.",
  "planRef": "plan.md §4.2 step 7",
  "helperVersion": "new",
  "clientCapability": "old",
  "elements": [
    {
      "kind": "log",
      "helperInput": {
        "id": "activity",
        "ns": "advisor",
        "kind": "log",
        "placement": "inline",
        "title": "Advisor",
        "payload": { "kind": "log", "lines": ["one", "two"], "tail": 50 }
      },
      "expectedNormalizedElement": {
        "id": "activity",
        "ns": "advisor",
        "kind": "log",
        "placement": "inline",
        "title": "Advisor",
        "payload": { "kind": "log", "lines": ["one", "two"], "tail": 50 }
      },
      "expectedClientElement": {
        "id": "activity",
        "ns": "advisor",
        "kind": "log",
        "placement": "inline",
        "title": "Advisor",
        "lines": ["one", "two"],
        "tail": 50
      }
    },
    {
      "kind": "diff",
      "helperInput": {
        "id": "d",
        "ns": "review",
        "kind": "diff",
        "placement": "inline",
        "payload": { "kind": "diff", "unifiedDiff": "--- a\n+++ b\n", "filePath": "src/a.ts" }
      },
      "expectedNormalizedElement": {
        "id": "d",
        "ns": "review",
        "kind": "diff",
        "placement": "inline",
        "payload": { "kind": "diff", "unifiedDiff": "--- a\n+++ b\n", "filePath": "src/a.ts" }
      },
      "expectedClientElement": {
        "id": "d",
        "ns": "review",
        "kind": "diff",
        "placement": "inline",
        "unifiedDiff": "--- a\n+++ b\n",
        "filePath": "src/a.ts",
        "diff": "--- a\n+++ b\n"
      }
    }
  ]
}
