node_modules/
dist/
.dev/
.tmp/
*.log
*.tsbuildinfo

# Playwright E2E run artifacts (apps/web/e2e; T31A) — traces, screenshots,
# and the HTML report the harness never serves.
test-results/
playwright-report/
blob-report/

# Generated protocol validators (gitignored in reference)
packages/protocol/src/generated/validation/*.aot.ts

# Expo/Android native prebuild and tooling output (apps/android; T16)
apps/android/.expo/
apps/android/android/
apps/android/ios/
.metro-health-check*

# Workflow agent scratch (worktrees, run state)
.pi/

# Android/EAS signing material and credentials exports (T44B1) — must never
# be committed. scripts/ci/guard-signing-material.mjs enforces this same
# list as a tracked-tree CI check, independent of whether a file is
# ignored: an already-tracked file is not un-tracked by adding an ignore
# rule for it, which is exactly why that guard exists alongside this list
# rather than instead of it.
*.keystore
*.jks
*.p12
*.pfx
*.pepk
*.mobileprovision
google-services.json
credentials.json

# Built application packages are a release ARTIFACT the release workflow
# produces and attaches to a GitHub Release — never a committed file.
*.apk
*.aab
